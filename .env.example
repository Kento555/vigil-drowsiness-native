# Get these from your Supabase project: Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Cloud Console → APIs & Services → Credentials.
# webClientId must be a "Web application" OAuth client, and its ID must also
# be added to Supabase's Google provider "Client IDs" field (this is what
# Supabase checks the native sign-in ID token's audience against).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
# Only needed to support Google sign-in on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR-IOS-CLIENT-ID.apps.googleusercontent.com
